# Copia este archivo a .env (que NO se sube a git). Los valores por defecto sirven para desarrollo.
POSTGRES_USER=sobanderia
POSTGRES_PASSWORD=sobanderia
POSTGRES_DB=sobanderia

# WhatsApp: "falso" escribe los mensajes en el registro; "cloudapi" envía de verdad (Fase 8 y 11)
PROVEEDOR_WHATSAPP=falso
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_VERSION_API=v21.0

# API: base de datos y entorno. ENTORNO es "desarrollo", "pruebas" o "produccion" (cualquier otro valor
# no arranca). Solo desarrollo y pruebas permiten `make seed`.
# En "produccion" la app NO arranca si queda configuración de desarrollo: base con credenciales de
# ejemplo o local, ORIGEN_WEB sin https o local, PROVEEDOR_WHATSAPP=falso, faltan las variables de
# WhatsApp o CORREO_PROVEEDOR no es «smtp» con su servidor y remitente. Un servidor previo al lanzamiento también es "produccion".
DATABASE_URL=postgresql+psycopg://sobanderia:sobanderia@localhost:5432/sobanderia
ENTORNO=desarrollo
# Dirección pública de la app (la usan CORS y los enlaces de los correos); en producción, https.
ORIGEN_WEB=http://localhost:5173
# Correo: "falso" escribe el mensaje (con su enlace) en el registro, solo en desarrollo y pruebas;
# "smtp" envía por cualquier proveedor SMTP y es obligatorio en producción.
CORREO_PROVEEDOR=falso
# CORREO_DESDE="Sobandería <no-responder@agenda.ejemplo.co>"
# SMTP_HOST=smtp.ejemplo.co
# SMTP_PUERTO=587
# SMTP_USUARIO=
# SMTP_CLAVE=
# SMTP_STARTTLS=true

# Detrás de un proxy (Caddy, ingreso de Azure): su IP o red, para que el límite por IP use la del
# cliente real. Vacío = no se confía en X-Forwarded-For.
# PROXY_CONFIABLE=10.0.0.0/8

# Topes contra el abuso (valores por defecto)
# CITAS_MAX_POR_CELULAR=2
# RESERVAS_MAX_IP=20
# ENLACE_MAX_HORA=3
# ENLACE_MAX_DIA=6
# Opcional: clave inicial de los usuarios de ejemplo (si falta, se genera una al azar)
SEED_CLAVE=

# Autenticación (opcionales; estos son los valores por defecto)
# INTENTOS_MAX_CORREO=5
# INTENTOS_MAX_IP=20
# VENTANA_INTENTOS_MIN=15
# SESION_INACTIVIDAD_HORAS=12
# SESION_MAXIMA_DIAS=7
# RECUPERACION_HORAS=2
